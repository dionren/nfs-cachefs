[Unit]
Description=NFS-CacheFS userspace daemon for Linux fscache + cachefiles
Documentation=man:nfs-cachefs(8)
# Must run before any NFS mount that uses -o fsc, otherwise the mount
# falls back to no caching.
DefaultDependencies=no
After=local-fs.target
Wants=remote-fs-pre.target
Before=remote-fs-pre.target
ConditionFileNotEmpty=/etc/nfs-cachefs/daemon.toml
# Keep retrying however often the daemon fails (the restart delay below
# grows instead): without the daemon, fsc mounts silently stop caching.
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/sbin/nfs-cachefs --config /etc/nfs-cachefs/daemon.toml
# The cachefiles module is in-tree on Ubuntu 24.04 but is not autoloaded.
# The '+' prefix keeps CAP_SYS_MODULE out of the long-running daemon while
# allowing this pre-start helper to load the module on a fresh boot.
ExecStartPre=+/sbin/modprobe -q cachefiles
# Restart on any exit systemd did not ask for: a stray SIGTERM/SIGHUP ends
# the daemon cleanly (exit 0), and the daemon exits on purpose when the
# kernel stops the cache after an I/O error, so that it is bound again.
Restart=always
RestartSec=2s
RestartSteps=6
RestartMaxDelaySec=2min
# Startup can take longer the first time max_size tags a large cache; the
# daemon extends this timeout while it works.
TimeoutStartSec=90s
# Closing /dev/cachefiles withdraws the cache, which syncs the whole cache
# filesystem — on a disk shared with busy containers that takes a while.
TimeoutStopSec=90s
# The daemon notifies at least every half interval, also during long cull
# passes and graveyard cleanups.
WatchdogSec=2min
KillSignal=SIGTERM
# Writable for the metrics textfile (metrics.textfile under /run/nfs-cachefs).
RuntimeDirectory=nfs-cachefs
RuntimeDirectoryMode=0755

# Hardening: cache dir is the only writable path. Daemon does no
# networking, no kernel module loading (the '+' ExecStartPre handles
# that with elevated caps), no realtime scheduling, and runs only on
# the host's native syscall ABI. Lock everything else down.
ProtectSystem=strict
ReadWritePaths=/var/cache/fscache
ProtectHome=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
PrivateTmp=true
PrivateNetwork=true
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
# CAP_SYS_ADMIN is required to write /dev/cachefiles configuration and to
# set the max_size project quota.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_DAC_READ_SEARCH

[Install]
WantedBy=multi-user.target
